# claude-launcher configuration.
#
# Copy to ~/.config/claude-launcher/config.env and set LAUNCHER_SECRET.
# `./setup.sh` does this for you and generates a strong secret.

# REQUIRED. Shared bearer secret the client must send as
#   Authorization: Bearer <secret>
# Generate one with:  openssl rand -hex 32
LAUNCHER_SECRET=

# Bind address. Keep 127.0.0.1 so the listener is reachable ONLY through the
# tunnel, never from the LAN or the public internet directly.
LAUNCHER_HOST=127.0.0.1
LAUNCHER_PORT=8787

# Directory the claude session starts in. It MUST be a folder you have already
# trusted in Claude Code (see README "Folder trust"), or the session will hang
# on the trust prompt. Defaults to $HOME if unset.
# LAUNCH_WORKDIR=/home/you/projects

# Prefix for generated session names. Defaults to the machine's hostname.
# SESSION_PREFIX=myhost

# Absolute path to the claude binary. If unset, it is resolved from PATH.
# CLAUDE_BIN=/home/you/.local/bin/claude
